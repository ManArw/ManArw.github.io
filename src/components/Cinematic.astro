---
// Film-like touches for a long, photo-led post:
//   - the title and cover open like the first shot of a film, and the cover
//     glows in its own colours and drifts as you scroll away from it;
//   - each "Steps today" count ticks up when you reach it, its pill filling
//     in proportion to the longest day;
//   - the closing quote becomes an end card that lights up word by word as
//     you read it.
// Put it once in an MDX post, at the very end (it adds no text, so the
// narration and search are unchanged):
//
//   <Cinematic cover={coverPhoto} />
//
// `cover` is the same photo as the post's `cover:` front matter. Readers who
// prefer reduced motion get everything in place, with nothing moving.
import type { ImageMetadata } from 'astro';
import { tone } from '../lib/tone';

interface Props {
  cover?: ImageMetadata;
}
const { cover } = Astro.props;
const glow = cover ? await tone(cover) : '';
---

{glow && <style is:inline set:html={`article>.cover{${glow}}`} />}

<style is:global>
  /* ---------- The opening shot ---------- */
  /* Centred without a transform, so its glow sits behind the page's text
     rather than over it. */
  article > .cover[class] {
    position: relative;
    transform: none;
    margin-left: calc(50% - min(50vw - 1rem, 32rem));
    overflow: hidden;
    border-radius: 12px;
    box-shadow:
      -2.4rem -1.6rem 6rem -1rem color-mix(in srgb, var(--g1) 55%, transparent),
      2.4rem -1.6rem 6rem -1rem color-mix(in srgb, var(--g2) 55%, transparent),
      -2.4rem 1.6rem 6rem -1rem color-mix(in srgb, var(--g3) 55%, transparent),
      2.4rem 1.6rem 6rem -1rem color-mix(in srgb, var(--g4) 55%, transparent);
  }
  article > .cover img {
    background-image: var(--ph, none);
  }

  @media (prefers-reduced-motion: no-preference) {
    article > .head > *,
    article > .listen,
    article > .toc {
      animation: cin-rise 1s var(--ease-out) backwards;
    }
    article > .head > :nth-child(2) {
      animation-delay: 0.08s;
    }
    article > .head > h1 {
      animation-duration: 1.4s;
      animation-delay: 0.16s;
    }
    article > .head > :nth-child(n + 4) {
      animation-delay: 0.3s;
    }
    article > .listen {
      animation-delay: 0.45s;
    }
    /* The cover opens out of a thin band, like a shutter, and settles. */
    article > .cover[class] {
      animation: cin-glow 2.2s ease-out 0.9s backwards;
    }
    article > .cover img {
      animation:
        cin-open 1.5s cubic-bezier(0.7, 0, 0.2, 1) 0.3s backwards,
        cin-settle 2.8s var(--ease-out) 0.3s backwards;
    }
    article > .toc {
      animation-delay: 1.1s;
    }
  }
  @keyframes cin-rise {
    from {
      opacity: 0;
      translate: 0 0.9rem;
      filter: blur(5px);
    }
  }
  @keyframes cin-open {
    from {
      clip-path: inset(49% 0);
    }
    to {
      clip-path: inset(0 0);
    }
  }
  @keyframes cin-settle {
    from {
      scale: 1.14;
    }
  }
  @keyframes cin-glow {
    from {
      box-shadow:
        0 0 0 0 transparent,
        0 0 0 0 transparent,
        0 0 0 0 transparent,
        0 0 0 0 transparent;
    }
  }
  /* Then drifts within its frame as it scrolls away. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      article > .cover img {
        animation-name: cin-open, cin-settle, cin-drift;
        animation-duration: 1.5s, 2.8s, auto;
        animation-timing-function: cubic-bezier(0.7, 0, 0.2, 1), var(--ease-out), linear;
        animation-delay: 0.3s, 0.3s, 0s;
        animation-fill-mode: backwards, backwards, both;
        animation-timeline: auto, auto, view();
        animation-range: normal, normal, exit 0% exit 100%;
      }
    }
  }
  @keyframes cin-drift {
    from {
      object-position: 50% 50%;
    }
    to {
      object-position: 50% 95%;
    }
  }

  /* ---------- Steps ---------- */
  .prose .steps {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    font-variant-numeric: tabular-nums;
  }
  .steps-fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(159, 194, 234, 0.08), rgba(159, 194, 234, 0.2));
    transform-origin: left;
    scale: var(--p, 0) 1;
    transition: scale 1.6s var(--ease-out);
  }
  .steps-n {
    display: inline-block;
    text-align: right;
    color: var(--ink);
  }

  /* ---------- The end card ---------- */
  .prose > blockquote:last-of-type {
    max-width: 30rem;
    margin: 3em auto 2.5em;
    padding: 0;
    border: 0;
    text-align: center;
    font-size: var(--step-2);
    line-height: 1.35;
    text-wrap: balance;
    color: var(--ink);
  }
  .prose > blockquote:last-of-type::before {
    content: '“';
    display: block;
    height: 0.55em;
    font-size: 2.6em;
    line-height: 1;
    color: var(--accent);
    opacity: 0.55;
  }
  @property --lit {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .lit-words {
        animation-name: cin-lit;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover 18% cover 52%;
      }
      .lit-words .w {
        opacity: clamp(0.16, calc(var(--lit) * (var(--n) + 3) - var(--i)), 1);
      }
    }
  }
  @keyframes cin-lit {
    from {
      --lit: 0;
    }
    to {
      --lit: 1;
    }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Steps: "Steps today: 13,251" counts up from zero when it comes into view.
  // Screen readers get the real number throughout.
  const fmt = new Intl.NumberFormat('en-US');
  const pills = [...document.querySelectorAll<HTMLElement>('.prose .steps')].flatMap((el) => {
    const m = /^([\s\S]*?)([\d,]+)\s*$/.exec(el.textContent ?? '');
    return m ? [{ el, label: m[1], n: Number(m[2].replace(/,/g, '')) }] : [];
  });
  const most = Math.max(...pills.map((p) => p.n));
  for (const { el, label, n } of pills) {
    const fill = document.createElement('span');
    fill.className = 'steps-fill';
    fill.setAttribute('aria-hidden', 'true');
    const shown = document.createElement('span');
    shown.className = 'steps-n';
    shown.setAttribute('aria-hidden', 'true');
    shown.style.minWidth = `${fmt.format(n).length}ch`;
    shown.textContent = reduce ? fmt.format(n) : '0';
    const real = document.createElement('span');
    real.className = 'visually-hidden';
    real.textContent = fmt.format(n);
    el.replaceChildren(fill, label, shown, real);
    if (reduce) el.style.setProperty('--p', String(n / most));
  }
  if (!reduce && pills.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.unobserve(e.target);
          const pill = pills.find((p) => p.el === e.target)!;
          const shown = pill.el.querySelector<HTMLElement>('.steps-n')!;
          pill.el.style.setProperty('--p', String(pill.n / most));
          const t0 = performance.now();
          const tick = (t: number) => {
            const k = Math.min(1, (t - t0) / 1500);
            shown.textContent = fmt.format(Math.round(pill.n * (1 - (1 - k) ** 3)));
            if (k < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      },
      { threshold: 1 },
    );
    pills.forEach((p) => io.observe(p.el));
  }

  // The end card: each word of the closing quote lights up in turn as it
  // scrolls up the screen (CSS does the lighting; this only marks the words).
  const quote = [...document.querySelectorAll<HTMLElement>('.prose > blockquote')].at(-1);
  if (quote && !reduce && CSS.supports('animation-timeline: view()')) {
    let i = 0;
    const mark = (node: Node) => {
      for (const child of [...node.childNodes]) {
        if (child.nodeType === Node.TEXT_NODE) {
          const words = document.createDocumentFragment();
          for (const part of (child.textContent ?? '').split(/(\s+)/)) {
            if (!part) continue;
            if (/^\s+$/.test(part)) {
              words.append(part);
            } else {
              const w = document.createElement('span');
              w.className = 'w';
              w.style.setProperty('--i', String(i++));
              w.textContent = part;
              words.append(w);
            }
          }
          child.replaceWith(words);
        } else {
          mark(child);
        }
      }
    };
    mark(quote);
    quote.style.setProperty('--n', String(i));
    quote.classList.add('lit-words');
  }
</script>
