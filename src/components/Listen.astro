---
// "Listen to this article". Plays a recorded narration when the piece has one
// (piece.audio), otherwise reads the article body aloud with the browser's
// own speech synthesis: no service, no keys, nothing to pay for. Hidden when
// neither is possible (no JS, or a browser without speech).
//
// Only the element marked [data-read-body] is read, so navigation, metadata,
// buttons, captions and the footer never are.
import type { Audio } from '../lib/content';

interface Props {
  words: number;
  title: string;
  audio?: Audio | null;
}
const { words, title, audio } = Astro.props;
// Browser voices read at roughly 170 words a minute at 1×.
const estimate = Math.max(1, Math.round(words / 170));
const mmss = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
const rates = [0.75, 1, 1.25, 1.5, 2];
---

<section class="listen" aria-label="Listen to this article" data-listen data-words={words} data-title={title} data-audio={audio?.url} data-duration={audio?.duration ?? undefined} hidden>
  <button type="button" class="start" data-start>
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M8 5.5v13l10.5-6.5z"></path></svg>
    <span>Listen to this article</span>
    <span class="est">{audio?.duration ? mmss(audio.duration) : `about ${estimate} min`}</span>
  </button>

  <div class="player" data-player hidden>
    <div class="controls">
      <button type="button" class="ctl toggle" data-toggle aria-label="Pause">
        <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><rect x="6.5" y="5" width="4" height="14" rx="1"></rect><rect x="13.5" y="5" width="4" height="14" rx="1"></rect></svg>
        <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M8 5.5v13l10.5-6.5z"></path></svg>
      </button>
      <button type="button" class="ctl" data-restart aria-label="Restart from the beginning">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 1 0 2.4-5.7"></path><path d="M4 4.5v4h4"></path></svg>
      </button>
      <input class="seek" type="range" min="0" max="1000" step="1" value="0" aria-label="Position in the article" data-seek />
      <span class="time" aria-hidden="true" data-time>0:00</span>
      <button type="button" class="ctl" data-stop aria-label="Stop and close the player">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6.5 6.5l11 11M17.5 6.5l-11 11"></path></svg>
      </button>
    </div>
    <div class="meta">
      <div class="rates" role="group" aria-label="Playback speed">
        {
          rates.map((r) => (
            <button type="button" data-rate={r} aria-pressed={r === 1 ? 'true' : 'false'}>
              {r}×
            </button>
          ))
        }
      </div>
      <p class="source" data-source>{audio ? 'Recorded narration' : 'Read aloud by your browser’s voice'}</p>
    </div>
    <p class="visually-hidden" role="status" data-status></p>
  </div>
</section>

<style>
  .listen {
    margin: 0 0 var(--space-5);
    font-family: var(--font-display);
  }
  .start {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    min-height: 44px;
    padding: 0.5em 1.1em 0.4em 0.85em;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition:
      border-color var(--dur-1),
      background-color var(--dur-1);
  }
  .start:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .start svg {
    width: 1.05em;
    height: 1.05em;
    color: var(--accent);
    margin-bottom: 0.1em;
  }
  .est {
    color: var(--ink-soft);
    font-weight: 400;
  }
  .est::before {
    content: '· ';
  }
  .player {
    padding: var(--space-2) var(--space-3) var(--space-3);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
  }
  .controls {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }
  .ctl {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .ctl:hover {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .ctl svg {
    width: 20px;
    height: 20px;
  }
  .toggle {
    color: var(--accent);
  }
  .toggle .i-play,
  .toggle.paused .i-pause {
    display: none;
  }
  .toggle.paused .i-play {
    display: block;
  }
  .seek {
    flex: 1;
    min-width: 0;
    height: 44px;
    margin: 0 var(--space-2);
    background: transparent;
    accent-color: var(--accent);
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }
  .seek::-webkit-slider-runnable-track {
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(to right, var(--accent) var(--pos, 0%), var(--line) var(--pos, 0%));
  }
  .seek::-moz-range-track {
    height: 2px;
    border-radius: 2px;
    background: var(--line);
  }
  .seek::-moz-range-progress {
    height: 2px;
    background: var(--accent);
  }
  .seek::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 12px;
    height: 12px;
    margin-top: -5px;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
  }
  .seek::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
  }
  .seek:focus-visible {
    outline-offset: 0;
  }
  .time {
    flex: none;
    min-width: 6.5em;
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
    text-align: right;
    white-space: nowrap;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding-left: var(--space-1);
  }
  .rates {
    display: flex;
    flex-wrap: wrap;
  }
  .rates button {
    min-width: 44px;
    min-height: 36px;
    padding: 0 0.5em;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-soft);
    font: inherit;
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }
  .rates button:hover {
    color: var(--ink);
  }
  .rates button[aria-pressed='true'] {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--ink);
    font-weight: 600;
  }
  .source {
    font-size: 0.8rem;
    color: var(--ink-soft);
    font-style: italic;
    font-family: var(--font-body);
  }
  @media (max-width: 480px) {
    .time {
      min-width: 0;
    }
    .controls {
      flex-wrap: wrap;
    }
    .seek {
      order: 5;
      flex-basis: 100%;
      margin: 0;
      height: 32px;
    }
    .time {
      margin-left: auto;
    }
  }
</style>

<script>
  type Pos = { frac: number; elapsed: number; total: number | null; approx: boolean };
  type Engine = {
    readonly playing: boolean;
    readonly finished: boolean;
    play(): void;
    pause(): void;
    restart(): void;
    seek(frac: number): void;
    setRate(rate: number): void;
    position(): Pos;
    stop(): void;
  };

  const root = document.querySelector<HTMLElement>('[data-listen]');
  const body = document.querySelector<HTMLElement>('[data-read-body]');
  const canSpeak = 'speechSynthesis' in window && typeof SpeechSynthesisUtterance === 'function';
  // Some browsers keep talking across page loads; this page starts quiet.
  if (canSpeak) speechSynthesis.cancel();
  if (root && body && (root.dataset.audio || canSpeak)) setup(root, body);

  // ---------- browser speech ----------

  // Leaf text blocks of the article body, in reading order.
  function readableBlocks(container: HTMLElement) {
    const SEL = 'p, h2, h3, h4, li, blockquote';
    return [...container.querySelectorAll<HTMLElement>(SEL)].filter(
      (el) =>
        !el.closest('figure, pre, nav, aside, button, [data-no-read]') &&
        !el.querySelector(SEL) &&
        /\p{L}/u.test(el.textContent ?? ''),
    );
  }

  function blockText(el: HTMLElement) {
    const clone = el.cloneNode(true) as HTMLElement;
    clone.querySelectorAll('sup, button, svg, img, [aria-hidden="true"]').forEach((n) => n.remove());
    let text = (clone.textContent ?? '').replace(/\s+/g, ' ').trim();
    // Give headings a beat before the paragraph that follows.
    if (/^H\d$/.test(el.tagName) && !/[.!?…:]$/.test(text)) text += '.';
    return text;
  }

  // Short utterances: Chrome drops long ones after ~15 seconds, and short
  // chunks make pause, seek and speed changes land close to where you are.
  function chunk(text: string, max = 180) {
    const out: string[] = [];
    let cur = '';
    const push = (part: string) => {
      if (cur && (cur + part).length > max) {
        out.push(cur.trim());
        cur = '';
      }
      cur += part;
    };
    for (const sentence of text.match(/[^.!?…]+(?:[.!?…]+["'”’)\]]*|$)\s*/g) ?? [text]) {
      if (sentence.length <= max) {
        push(sentence);
        continue;
      }
      for (const clause of sentence.split(/(?<=[,;:—–])\s+/)) {
        if (clause.length <= max) push(clause + ' ');
        else for (const word of clause.split(' ')) push(word + ' ');
      }
    }
    if (cur.trim()) out.push(cur.trim());
    return out;
  }

  function pickVoice() {
    const voices = speechSynthesis.getVoices().filter((v) => /^en([-_]|$)/i.test(v.lang));
    const novelty = /albert|bad news|bahh|bells|boing|bubbles|cellos|good news|jester|organ|superstar|trinoids|whisper|wobble|zarvox|hysterical|eloquence/i;
    const score = (v: SpeechSynthesisVoice) =>
      (/natural|neural|premium|enhanced/i.test(v.name) ? 4 : 0) +
      (/google/i.test(v.name) ? 2 : 0) +
      (/en[-_]in/i.test(v.lang) ? 1.5 : /en[-_]gb/i.test(v.lang) ? 1.2 : /en[-_]us/i.test(v.lang) ? 1 : 0) +
      (v.default ? 0.5 : 0) -
      (novelty.test(v.name) ? 10 : 0);
    return voices.sort((a, b) => score(b) - score(a))[0] ?? null;
  }

  function speechEngine(container: HTMLElement, words: number, onUpdate: () => void, onError: (msg: string) => void): Engine {
    const synth = window.speechSynthesis;
    synth.cancel(); // anything left over from another page in this tab

    const blocks = readableBlocks(container);
    const chunks: { block: number; text: string; start: number }[] = [];
    let total = 0;
    blocks.forEach((el, block) => {
      for (const text of chunk(blockText(el))) {
        chunks.push({ block, text, start: total });
        total += text.length + 1;
      }
    });

    let index = 0;
    let offset = 0;
    let rate = 1;
    let playing = false;
    let generation = 0; // stale events from cancelled utterances are ignored
    let voice = pickVoice();
    synth.addEventListener?.('voiceschanged', () => (voice = pickVoice()));

    let current: HTMLElement | null = null;
    const highlight = (block: number) => {
      const el = blocks[block] ?? null;
      if (el === current) return;
      current?.classList.remove('is-speaking');
      el?.classList.add('is-speaking');
      current = el;
    };

    const silence = () => {
      generation++;
      const busy = synth.speaking || synth.pending;
      if (busy) synth.cancel();
      return busy;
    };

    const speak = () => {
      const mine = ++generation;
      const c = chunks[index];
      if (!c) {
        playing = false;
        index = chunks.length;
        highlight(-1);
        onUpdate();
        return;
      }
      highlight(c.block);
      const u = new SpeechSynthesisUtterance(c.text);
      u.rate = rate;
      u.lang = voice?.lang ?? document.documentElement.lang ?? 'en';
      if (voice) u.voice = voice;
      let started = false;
      u.onstart = () => (started = true);
      u.onboundary = (e) => {
        if (mine !== generation) return;
        offset = e.charIndex;
        onUpdate();
      };
      u.onend = () => {
        if (mine !== generation) return;
        index++;
        offset = 0;
        speak();
        onUpdate();
      };
      u.onerror = (e) => {
        if (mine !== generation || e.error === 'interrupted' || e.error === 'canceled') return;
        playing = false;
        generation++;
        onError(e.error === 'not-allowed' ? 'Press play again to start listening.' : 'The browser voice stopped unexpectedly.');
        onUpdate();
      };
      synth.speak(u);
      // Some browsers expose the API but have no voice installed: nothing
      // ever starts. Say so instead of sitting there silently.
      window.setTimeout(() => {
        if (mine === generation && playing && !started && !synth.speaking) {
          playing = false;
          generation++;
          synth.cancel();
          onError('This browser has no voice to read with. Try Chrome, Edge or Safari.');
          onUpdate();
        }
      }, 4000);
    };

    // After a cancel, Safari needs a moment before it accepts a new utterance.
    const restartSpeech = () => {
      if (silence()) window.setTimeout(() => playing && speak(), 80);
      else speak();
    };

    return {
      get playing() {
        return playing;
      },
      get finished() {
        return index >= chunks.length;
      },
      play() {
        if (playing) return;
        if (index >= chunks.length) index = 0;
        playing = true;
        offset = 0;
        restartSpeech();
        onUpdate();
      },
      pause() {
        if (!playing) return;
        playing = false;
        offset = 0;
        silence();
        onUpdate();
      },
      restart() {
        index = 0;
        offset = 0;
        if (!playing) return this.play();
        restartSpeech();
        onUpdate();
      },
      seek(frac) {
        const target = frac * total;
        const i = chunks.findIndex((c) => c.start + c.text.length >= target);
        index = i < 0 ? chunks.length - 1 : i;
        offset = 0;
        if (playing) restartSpeech();
        else highlight(chunks[index]?.block ?? -1);
        onUpdate();
      },
      setRate(r) {
        rate = r;
        if (playing) restartSpeech();
        onUpdate();
      },
      position() {
        const c = chunks[index];
        const chars = c ? c.start + Math.min(offset, c.text.length) : total;
        const frac = total ? chars / total : 0;
        const duration = ((words / 170) * 60) / rate;
        return { frac, elapsed: frac * duration, total: duration, approx: true };
      },
      stop() {
        playing = false;
        silence();
        index = 0;
        offset = 0;
        highlight(-1);
        onUpdate();
      },
    };
  }

  // ---------- recorded narration ----------

  function audioEngine(url: string, known: number | null, title: string, onUpdate: () => void, onError: (msg: string) => void): Engine {
    const a = new Audio();
    a.preload = 'none';
    a.src = url;
    ['timeupdate', 'loadedmetadata', 'play', 'pause', 'ended', 'ratechange'].forEach((ev) => a.addEventListener(ev, onUpdate));
    a.addEventListener('error', () => onError('The recording couldn’t be loaded.'));
    const duration = () => (Number.isFinite(a.duration) && a.duration > 0 ? a.duration : known);
    if ('mediaSession' in navigator) {
      a.addEventListener('play', () => {
        navigator.mediaSession.metadata = new MediaMetadata({ title, artist: 'Manas H Arawalli' });
      });
    }
    return {
      get playing() {
        return !a.paused && !a.ended;
      },
      get finished() {
        return a.ended;
      },
      play() {
        a.play().catch(() => onError('Press play again to start listening.'));
      },
      pause() {
        a.pause();
      },
      restart() {
        a.currentTime = 0;
        this.play();
      },
      seek(frac) {
        const d = duration();
        if (d) a.currentTime = frac * d;
      },
      setRate(r) {
        a.playbackRate = r;
      },
      position() {
        const d = duration();
        return { frac: d ? a.currentTime / d : 0, elapsed: a.currentTime, total: d, approx: false };
      },
      stop() {
        a.pause();
        a.currentTime = 0;
      },
    };
  }

  // ---------- the player ----------

  function setup(root: HTMLElement, body: HTMLElement) {
    root.hidden = false;
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const start = $<HTMLButtonElement>('[data-start]');
    const player = $('[data-player]');
    const toggle = $<HTMLButtonElement>('[data-toggle]');
    const seek = $<HTMLInputElement>('[data-seek]');
    const time = $('[data-time]');
    const status = $('[data-status]');
    const source = $('[data-source]');
    const rateButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-rate]')];
    const words = Number(root.dataset.words) || 0;

    let engine: Engine | null = null;
    let rate = 1;
    let dragging = false;
    let lastState = '';
    try {
      const saved = Number(localStorage.getItem('listen-rate'));
      if ([0.75, 1, 1.25, 1.5, 2].includes(saved)) rate = saved;
    } catch {}

    const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
    const spoken = (s: number) => {
      const m = Math.floor(s / 60);
      const sec = Math.floor(s % 60);
      return [m && `${m} minute${m === 1 ? '' : 's'}`, `${sec} second${sec === 1 ? '' : 's'}`].filter(Boolean).join(' ');
    };

    const announce = (msg: string) => {
      status.textContent = msg;
    };
    const fail = (msg: string) => {
      announce(msg);
      source.textContent = msg;
    };

    function update() {
      if (!engine) return;
      const p = engine.position();
      toggle.classList.toggle('paused', !engine.playing);
      toggle.setAttribute('aria-label', engine.playing ? 'Pause' : engine.finished ? 'Play again from the start' : 'Play');
      if (!dragging) {
        seek.value = String(Math.round(p.frac * 1000));
        seek.style.setProperty('--pos', `${(p.frac * 100).toFixed(2)}%`);
      }
      const total = p.total ? `${p.approx ? '~' : ''}${clock(p.total)}` : '';
      time.textContent = total ? `${clock(p.elapsed)} / ${total}` : clock(p.elapsed);
      seek.setAttribute('aria-valuetext', p.total ? `${spoken(p.elapsed)} of ${p.approx ? 'about ' : ''}${spoken(p.total)}` : spoken(p.elapsed));
      const state = engine.playing ? 'Playing' : engine.finished ? 'Finished' : 'Paused';
      if (state !== lastState) {
        if (lastState) announce(state);
        lastState = state;
      }
    }

    function makeEngine(): Engine {
      const url = root.dataset.audio;
      if (url) {
        return audioEngine(url, Number(root.dataset.duration) || null, root.dataset.title ?? document.title, update, (msg) => {
          // A missing recording falls back to the browser voice where possible.
          if (canSpeak) {
            engine = speechEngine(body, words, update, fail);
            source.textContent = 'Read aloud by your browser’s voice';
            engine.setRate(rate);
            engine.play();
          } else fail(msg);
        });
      }
      return speechEngine(body, words, update, fail);
    }

    function setRate(r: number) {
      rate = r;
      rateButtons.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.rate) === r)));
      engine?.setRate(r);
      try {
        localStorage.setItem('listen-rate', String(r));
      } catch {}
    }

    start.addEventListener('click', () => {
      engine ??= makeEngine();
      setRate(rate);
      start.hidden = true;
      player.hidden = false;
      engine.play();
      toggle.focus();
      update();
    });
    toggle.addEventListener('click', () => (engine?.playing ? engine.pause() : engine?.play()));
    $('[data-restart]').addEventListener('click', () => engine?.restart());
    $('[data-stop]').addEventListener('click', () => {
      engine?.stop();
      player.hidden = true;
      start.hidden = false;
      lastState = '';
      start.focus();
    });
    rateButtons.forEach((b) => b.addEventListener('click', () => setRate(Number(b.dataset.rate))));
    // Show where you'd land while dragging; jump only when you let go.
    seek.addEventListener('input', () => {
      dragging = true;
      seek.style.setProperty('--pos', `${Number(seek.value) / 10}%`);
    });
    seek.addEventListener('change', () => {
      dragging = false;
      engine?.seek(Number(seek.value) / 1000);
    });
    setRate(rate);

    // Never keep talking after the reader leaves the page.
    window.addEventListener('pagehide', () => engine?.stop());
  }
</script>
