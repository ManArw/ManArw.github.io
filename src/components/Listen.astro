---
// "Listen to this piece": a small player for the piece's generated narration
// (see docs/AUDIO.md). It's a plain HTML5 <audio> element underneath, so speed
// changes are just playbackRate on an ordinary recording: 2× is the same file
// played faster, nothing gets re-spoken. Nothing downloads until Play.
import type { Audio } from '../lib/content';
import { site } from '../data/site';

interface Props {
  audio: Audio;
  title: string;
}
const { audio, title } = Astro.props;
const mmss = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
const minutes = Math.max(1, Math.round(audio.duration / 60));
const rates = [0.75, 1, 1.25, 1.5, 2];
---

<section class="listen" aria-labelledby="listen-title" data-listen data-title={title} data-artist={site.name} data-duration={audio.duration}>
  <p class="head">
    <span id="listen-title">Listen to this piece</span>
    <span class="len">{minutes} min</span>
  </p>
  <audio preload="none" src={audio.src} data-audio>
    <a href={audio.src}>Download the narration (MP3)</a>
  </audio>

  <div class="controls">
    <button type="button" class="toggle paused" data-toggle aria-label="Play the narration">
      <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M8 5.5v13l10.5-6.5z"></path></svg>
      <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><rect x="6.5" y="5" width="4" height="14" rx="1"></rect><rect x="13.5" y="5" width="4" height="14" rx="1"></rect></svg>
      <span class="i-wait" aria-hidden="true"></span>
    </button>
    <input
      class="seek"
      type="range"
      min="0"
      max={Math.ceil(audio.duration)}
      step="1"
      value="0"
      aria-label="Position in the narration"
      aria-valuetext={`0 seconds of ${minutes} minutes`}
      data-seek
    />
    <span class="time" aria-hidden="true"><span data-now>0:00</span> / <span data-total>{mmss(audio.duration)}</span></span>
  </div>

  <div class="meta">
    <div class="rates" role="group" aria-label="Playback speed">
      {
        rates.map((r) => (
          <button type="button" data-rate={r} aria-pressed={r === 1 ? 'true' : 'false'}>
            {r}×
          </button>
        ))
      }
    </div>
    <p class="note" data-note>Read by an open-source voice</p>
  </div>
  <p class="visually-hidden" role="status" data-status></p>
</section>

<style>
  .listen {
    margin: 0 0 var(--space-5);
    padding: var(--space-3) var(--space-3) var(--space-2);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    font-family: var(--font-display);
  }
  .head {
    display: flex;
    align-items: baseline;
    gap: 0.6em;
    padding-left: var(--space-1);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .len {
    font-weight: 400;
    letter-spacing: 0.06em;
  }
  .len::before {
    content: '· ';
  }
  .controls {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }
  .toggle {
    position: relative;
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent);
    border-radius: 999px;
    background: transparent;
    color: var(--accent);
    cursor: pointer;
    transition:
      background-color var(--dur-1),
      border-color var(--dur-1);
  }
  .toggle:hover {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    border-color: var(--accent);
  }
  .toggle svg {
    width: 20px;
    height: 20px;
  }
  .toggle .i-play,
  .toggle .i-wait,
  .toggle.paused .i-pause,
  .toggle.waiting .i-pause,
  .toggle.waiting .i-play {
    display: none;
  }
  .toggle.paused:not(.waiting) .i-play {
    display: block;
    margin-left: 2px;
  }
  /* Loading: a slow breathing ring, or just a still one with reduced motion. */
  .toggle.waiting .i-wait {
    display: block;
    width: 16px;
    height: 16px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    border-right-color: transparent;
    animation: turn 0.9s linear infinite;
  }
  @keyframes turn {
    to {
      transform: rotate(1turn);
    }
  }
  .seek {
    flex: 1;
    min-width: 0;
    height: 44px;
    margin: 0;
    background: transparent;
    accent-color: var(--accent);
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }
  .seek::-webkit-slider-runnable-track {
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(to right, var(--accent) var(--pos, 0%), var(--line) var(--pos, 0%));
  }
  .seek::-moz-range-track {
    height: 2px;
    border-radius: 2px;
    background: var(--line);
  }
  .seek::-moz-range-progress {
    height: 2px;
    background: var(--accent);
  }
  .seek::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 12px;
    height: 12px;
    margin-top: -5px;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
  }
  .seek::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
  }
  .seek:focus-visible {
    outline-offset: 0;
  }
  .time {
    flex: none;
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--space-3);
  }
  .rates {
    display: flex;
    flex-wrap: wrap;
    margin-left: calc(var(--space-1) * -1);
  }
  .rates button {
    min-width: 44px;
    min-height: 36px;
    padding: 0 0.5em;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-soft);
    font: inherit;
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }
  .rates button:hover {
    color: var(--ink);
  }
  .rates button[aria-pressed='true'] {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--ink);
    font-weight: 600;
  }
  .note {
    padding-right: var(--space-1);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-style: italic;
    color: var(--ink-soft);
  }
  .listen.failed .note {
    color: var(--ink);
  }
  @media (max-width: 480px) {
    .controls {
      flex-wrap: wrap;
      row-gap: 0;
    }
    .seek {
      order: 3;
      flex-basis: 100%;
      height: 32px;
    }
    .time {
      margin-left: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .toggle.waiting .i-wait {
      animation: none;
      border-right-color: currentColor;
      opacity: 0.6;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-listen]');
  if (root) setup(root);

  function setup(root: HTMLElement) {
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const audio = $<HTMLAudioElement>('[data-audio]');
    const toggle = $<HTMLButtonElement>('[data-toggle]');
    const seek = $<HTMLInputElement>('[data-seek]');
    const now = $('[data-now]');
    const totalEl = $('[data-total]');
    const note = $('[data-note]');
    const status = $('[data-status]');
    const rateButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-rate]')];

    const known = Number(root.dataset.duration) || 0;
    const posKey = `listen-pos:${audio.getAttribute('src')}`;
    let dragging = false;
    let started = false;
    let failed = false;
    let lastSaved = 0;

    // Remembered for this visit only (sessionStorage): no tracking.
    const read = (k: string) => {
      try {
        return sessionStorage.getItem(k);
      } catch {
        return null;
      }
    };
    const write = (k: string, v: string | null) => {
      try {
        v == null ? sessionStorage.removeItem(k) : sessionStorage.setItem(k, v);
      } catch {}
    };

    const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
    const spoken = (s: number) => {
      const m = Math.floor(s / 60);
      const sec = Math.floor(s % 60);
      return [m && `${m} minute${m === 1 ? '' : 's'}`, `${sec} second${sec === 1 ? '' : 's'}`].filter(Boolean).join(' ');
    };
    // The manifest's length is exact (counted while rendering); some browsers
    // only estimate an MP3's length, so it wins when we have it.
    const duration = () => known || (Number.isFinite(audio.duration) ? audio.duration : 0);
    const announce = (msg: string) => (status.textContent = msg);

    function paint(t = audio.currentTime) {
      const d = duration();
      if (!dragging) seek.value = String(Math.floor(t));
      seek.max = String(Math.ceil(d));
      seek.style.setProperty('--pos', `${d ? Math.min(100, (t / d) * 100) : 0}%`);
      seek.setAttribute('aria-valuetext', `${spoken(t)} of ${spoken(d)}`);
      now.textContent = clock(t);
      totalEl.textContent = clock(d);
    }

    function paintButton() {
      const playing = !audio.paused && !audio.ended;
      toggle.classList.toggle('paused', !playing);
      toggle.setAttribute(
        'aria-label',
        playing
          ? 'Pause the narration'
          : failed
            ? 'Try loading the narration again'
            : audio.ended
              ? 'Play the narration again'
              : started
                ? 'Resume the narration'
                : 'Play the narration',
      );
    }

    const waiting = (on: boolean) => {
      toggle.classList.toggle('waiting', on);
      toggle.setAttribute('aria-busy', String(on));
    };

    function setRate(r: number) {
      audio.defaultPlaybackRate = r;
      audio.playbackRate = r;
      rateButtons.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.rate) === r)));
      write('listen-rate', String(r));
    }

    // Coming back to the piece later in the visit picks up where you left off.
    const saved = Number(read(posKey));
    if (saved > 5 && saved < known - 5) {
      audio.currentTime = saved; // applied once the file starts loading
      paint(saved);
      started = true;
      paintButton();
    }
    const savedRate = Number(read('listen-rate'));
    setRate([0.75, 1, 1.25, 1.5, 2].includes(savedRate) ? savedRate : 1);

    async function play() {
      if (failed) {
        failed = false;
        root.classList.remove('failed');
        note.textContent = 'Read by an open-source voice';
        audio.load();
      }
      started = true;
      waiting(audio.readyState < 3);
      try {
        // Seeking before the file loaded: honour it now.
        if (audio.readyState === 0 && Number(seek.value) > 0) audio.currentTime = Number(seek.value);
        await audio.play();
      } catch (err) {
        waiting(false);
        if ((err as DOMException).name !== 'AbortError') announce('Press play again to start the narration.');
      }
      paintButton();
    }

    toggle.addEventListener('click', () => (audio.paused || audio.ended ? play() : audio.pause()));
    rateButtons.forEach((b) => b.addEventListener('click', () => setRate(Number(b.dataset.rate))));

    // Dragging shows where you'd land; letting go (or arrow keys) moves there.
    seek.addEventListener('input', () => {
      dragging = true;
      paint(Number(seek.value));
    });
    seek.addEventListener('change', () => {
      dragging = false;
      audio.currentTime = Number(seek.value);
      paint(Number(seek.value));
    });

    audio.addEventListener('timeupdate', () => {
      paint();
      if (Math.abs(audio.currentTime - lastSaved) > 3) {
        lastSaved = audio.currentTime;
        write(posKey, String(Math.floor(audio.currentTime)));
      }
    });
    audio.addEventListener('loadedmetadata', () => paint());
    audio.addEventListener('playing', () => {
      waiting(false);
      paintButton();
      announce('Playing');
    });
    audio.addEventListener('pause', () => {
      paintButton();
      if (!audio.ended && !failed) announce('Paused');
      write(posKey, String(Math.floor(audio.currentTime)));
    });
    audio.addEventListener('waiting', () => waiting(true));
    audio.addEventListener('canplay', () => waiting(false));
    audio.addEventListener('ended', () => {
      waiting(false);
      paintButton();
      announce('Finished');
      write(posKey, null);
    });
    audio.addEventListener('error', () => {
      if (!started) return; // nothing requested yet (preload="none")
      failed = true;
      waiting(false);
      root.classList.add('failed');
      note.textContent = 'The narration couldn’t load. Press play to try again; the text is all here.';
      announce('The narration couldn’t load.');
      paintButton();
    });
    window.addEventListener('pagehide', () => {
      if (started && !audio.ended) write(posKey, String(Math.floor(audio.currentTime)));
    });

    // Lock-screen and headphone controls on phones.
    if ('mediaSession' in navigator) {
      audio.addEventListener('play', () => {
        navigator.mediaSession.metadata = new MediaMetadata({ title: root.dataset.title ?? document.title, artist: root.dataset.artist });
      });
      const skip = (by: number) => () => (audio.currentTime = Math.max(0, Math.min(duration(), audio.currentTime + by)));
      try {
        navigator.mediaSession.setActionHandler('play', () => play());
        navigator.mediaSession.setActionHandler('pause', () => audio.pause());
        navigator.mediaSession.setActionHandler('seekbackward', skip(-15));
        navigator.mediaSession.setActionHandler('seekforward', skip(15));
        navigator.mediaSession.setActionHandler('seekto', (e) => e.seekTime != null && (audio.currentTime = e.seekTime));
      } catch {}
    }
  }
</script>
