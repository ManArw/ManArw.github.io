---
// Optimised photo with a caption, for use inside MDX posts.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  wide?: boolean;
}
const { src, alt, caption, wide = false } = Astro.props;
---

<figure class:list={['fig', { wide }]}>
  <Image src={src} alt={alt} widths={[640, 1024, 1600]} sizes={wide ? '(min-width: 1100px) 64rem, 100vw' : '(min-width: 700px) 40rem, 100vw'} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fig.wide {
    width: min(100vw - 2rem, 64rem);
    margin-left: 50%;
    transform: translateX(-50%);
  }
  .fig :global(img) {
    width: 100%;
    max-height: none;
    border-radius: 10px;
  }
</style>
