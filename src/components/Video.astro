---
// A short, muted, looping clip. It only downloads and plays while on screen,
// and it doesn't autoplay at all for visitors who prefer reduced motion or
// have asked their browser to save data (they get a play button).
//
//   small     a lighter file for phones (screens up to 700px wide)
//   ratio     the frame's shape, e.g. "21/9" (default square)
//   mratio    its shape on phones, if different
//   bleed     edge to edge on most screens, like a full-width photo
//   sound     the clip has sound worth hearing: adds a sound button. It still
//             starts muted, and only plays sound after a reader turns it on
//             (and goes quiet again when it scrolls away). Tall (portrait)
//             clips are kept shorter than the screen automatically.
interface Props {
  src: string;
  poster: string;
  caption?: string;
  label: string;
  small?: string;
  ratio?: string;
  mratio?: string;
  bleed?: boolean;
  position?: string;
  sound?: boolean;
}
const { src, poster, caption, label, small, ratio = '1', mratio, bleed = false, position = '50% 50%', sound = false } = Astro.props;
---

<figure class:list={['clip', { bleed }]} style={`--ratio:${ratio};--mratio:${mratio ?? ratio};--pos:${position}`}>
  <div class="frame">
    <video muted loop playsinline preload="none" poster={poster} aria-label={label} data-clip>
      {small && <source src={src} type="video/mp4" media="(min-width: 701px)" />}
      <source src={small ?? src} type="video/mp4" />
    </video>
    <button type="button" class="toggle" aria-label="Pause video" data-clip-toggle>
      <svg class="pause" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><rect x="6.5" y="5" width="4" height="14" rx="1"></rect><rect x="13.5" y="5" width="4" height="14" rx="1"></rect></svg>
      <svg class="play" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M8 5.5v13l10.5-6.5z"></path></svg>
    </button>
    {
      sound && (
        <button type="button" class="toggle sound" aria-label="Turn sound on" data-on="false" data-clip-sound>
          <svg class="off" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor"></path><path d="M16 9.5l5 5M21 9.5l-5 5"></path></svg>
          <svg class="on" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor"></path><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11"></path></svg>
        </button>
      )
    }
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .frame {
    position: relative;
  }
  /* A tall clip never runs taller than the screen. */
  .clip:not(.bleed) .frame {
    max-width: calc(82vh * var(--ratio));
    margin-inline: auto;
  }
  @media (max-width: 700px) {
    .clip:not(.bleed) .frame {
      max-width: calc(82vh * var(--mratio));
    }
  }
  video {
    display: block;
    width: 100%;
    aspect-ratio: var(--ratio);
    object-fit: cover;
    object-position: var(--pos);
    border-radius: 10px;
    background: var(--line);
  }
  @media (max-width: 700px) {
    video {
      aspect-ratio: var(--mratio);
    }
  }
  .bleed {
    width: min(100vw, 80rem);
    margin: 3em 0 3em calc(50% - min(50vw, 40rem));
  }
  .bleed video {
    border-radius: 0;
  }
  @media (min-width: 80rem) {
    .bleed video {
      border-radius: 14px;
    }
  }
  .bleed figcaption {
    width: min(100% - 2rem, var(--measure));
    margin-inline: auto;
  }
  .toggle {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: rgba(10, 18, 32, 0.6);
    color: #fff;
    cursor: pointer;
  }
  .toggle svg {
    width: 18px;
    height: 18px;
  }
  .toggle .play,
  .toggle.paused .pause {
    display: none;
  }
  .toggle.paused .play {
    display: block;
  }
  .sound {
    right: calc(0.75rem + 44px + 0.5rem);
  }
  .sound .on,
  .sound[data-on='true'] .off {
    display: none;
  }
  .sound[data-on='true'] .on {
    display: block;
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
  document.querySelectorAll<HTMLVideoElement>('[data-clip]').forEach((video) => {
    const btn = video.parentElement!.querySelector<HTMLButtonElement>('[data-clip-toggle]')!;
    let userPaused = reduce || saveData;
    const sync = () => {
      btn.classList.toggle('paused', video.paused);
      btn.setAttribute('aria-label', video.paused ? 'Play video' : 'Pause video');
    };
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    sync();

    // Optional sound: muted until the reader asks, one clip at a time, and
    // muted again once the clip scrolls out of view.
    const soundBtn = video.parentElement!.querySelector<HTMLButtonElement>('[data-clip-sound]');
    const syncSound = () => {
      if (!soundBtn) return;
      soundBtn.dataset.on = String(!video.muted);
      soundBtn.setAttribute('aria-label', video.muted ? 'Turn sound on' : 'Turn sound off');
    };
    video.addEventListener('volumechange', syncSound);
    soundBtn?.addEventListener('click', () => {
      if (video.muted) {
        document.querySelectorAll<HTMLVideoElement>('[data-clip]').forEach((v) => (v.muted = true));
        video.muted = false;
        userPaused = false;
        video.play().catch(() => {});
      } else {
        video.muted = true;
      }
    });

    btn.addEventListener('click', () => {
      if (video.paused) {
        userPaused = false;
        video.play();
      } else {
        userPaused = true;
        video.pause();
      }
    });
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting && !userPaused) video.play().catch(() => {});
        else if (!e.isIntersecting) {
          video.pause();
          video.muted = true;
        }
      },
      { threshold: 0.35 },
    ).observe(video);
  });
</script>
