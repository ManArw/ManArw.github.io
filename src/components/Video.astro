---
// A short, muted, looping clip. It only downloads and plays while on screen,
// and it doesn't autoplay at all for visitors who prefer reduced motion.
interface Props {
  src: string;
  poster: string;
  caption?: string;
  label: string;
}
const { src, poster, caption, label } = Astro.props;
---

<figure class="clip">
  <div class="frame">
    <video muted loop playsinline preload="none" poster={poster} aria-label={label} data-clip>
      <source src={src} type="video/mp4" />
    </video>
    <button type="button" class="toggle" aria-label="Pause video" data-clip-toggle>
      <svg class="pause" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><rect x="6.5" y="5" width="4" height="14" rx="1"></rect><rect x="13.5" y="5" width="4" height="14" rx="1"></rect></svg>
      <svg class="play" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M8 5.5v13l10.5-6.5z"></path></svg>
    </button>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .frame {
    position: relative;
  }
  video {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 10px;
    background: var(--line);
  }
  .toggle {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: rgba(10, 18, 32, 0.6);
    color: #fff;
    cursor: pointer;
  }
  .toggle svg {
    width: 18px;
    height: 18px;
  }
  .toggle .play,
  .toggle.paused .pause {
    display: none;
  }
  .toggle.paused .play {
    display: block;
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLVideoElement>('[data-clip]').forEach((video) => {
    const btn = video.parentElement!.querySelector<HTMLButtonElement>('[data-clip-toggle]')!;
    let userPaused = reduce;
    const sync = () => {
      btn.classList.toggle('paused', video.paused);
      btn.setAttribute('aria-label', video.paused ? 'Play video' : 'Pause video');
    };
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    sync();
    btn.addEventListener('click', () => {
      if (video.paused) {
        userPaused = false;
        video.play();
      } else {
        userPaused = true;
        video.pause();
      }
    });
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting && !userPaused) video.play().catch(() => {});
        else if (!e.isIntersecting) video.pause();
      },
      { threshold: 0.35 },
    ).observe(video);
  });
</script>
