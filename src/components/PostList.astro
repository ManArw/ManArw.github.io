---
// A quiet, typographic list of pieces: date, title, excerpt, reading time,
// and (filled in after load) how many people reacted. Optionally grouped by
// year so it still reads calmly when the archive gets long.
import { kindLabel, type Piece } from '../lib/content';
import { site } from '../data/site';

interface Props {
  pieces: Piece[];
  byYear?: boolean;
  showKind?: boolean;
}
const { pieces, byYear = false, showKind = false } = Astro.props;
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const groups: [string | null, Piece[]][] = [];
for (const p of pieces) {
  const key = byYear ? String(p.date.getFullYear()) : null;
  const last = groups.at(-1);
  if (last && last[0] === key) last[1].push(p);
  else groups.push([key, [p]]);
}
---

<div class="archive" data-reaction-totals={site.api}>
  {
    groups.map(([year, list]) => (
      <section class="group" aria-labelledby={year ? `year-${year}` : undefined}>
        {year && (
          <h2 class="year" id={`year-${year}`}>
            {year}
          </h2>
        )}
        <ol class="posts" role="list">
          {list.map((p, i) => (
            <li class="reveal" style={`--delay:${Math.min(i, 6) * 60}ms`}>
              <a href={p.href}>
                <time datetime={p.date.toISOString()}>{fmt.format(p.date)}</time>
                <span class="body">
                  <span class="title">{p.title}</span>
                  <span class="sub">{p.excerpt}</span>
                  {p.tags.length > 0 && <span class="tags">{p.tags.slice(0, 4).join(' · ')}</span>}
                </span>
                <span class="meta">
                  {showKind && <span>{kindLabel(p.kind)}</span>}
                  <span>{p.minutes} min</span>
                  <span class="hearts" data-total-for={p.id} hidden />
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .group + .group {
    margin-top: var(--space-5);
  }
  .year {
    margin-bottom: var(--space-2);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--ink-soft);
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  li {
    border-bottom: 1px solid var(--line);
  }
  a {
    display: grid;
    grid-template-columns: 7.5rem 1fr auto;
    gap: var(--space-2) var(--space-4);
    align-items: baseline;
    padding-block: var(--space-4);
    text-decoration: none;
  }
  time,
  .meta {
    font-family: var(--font-display);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }
  .title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.2;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0 1.5px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size var(--dur-2) var(--ease-out);
    width: fit-content;
    overflow-wrap: anywhere;
  }
  a:hover .title,
  a:focus-visible .title {
    background-size: 100% 1.5px;
  }
  .sub {
    font-style: italic;
    color: var(--ink-soft);
    line-height: 1.45;
  }
  .tags {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--accent) 80%, var(--ink-soft));
  }
  .hearts::before {
    content: '♡ ';
  }
  @media (max-width: 640px) {
    a {
      grid-template-columns: 1fr auto;
    }
    time {
      grid-column: 1;
    }
    .meta {
      grid-column: 2;
      grid-row: 1;
      flex-direction: row;
      gap: var(--space-2);
    }
    .body {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  // Quiet reaction totals next to each piece. One request for the whole list,
  // after the page has settled; nothing shows if the counter can't be reached.
  const root = document.querySelector<HTMLElement>('[data-reaction-totals]');
  const spots = [...document.querySelectorAll<HTMLElement>('[data-total-for]')];
  if (root && spots.length) {
    const run = () =>
      fetch(`${root.dataset.reactionTotals}/reactions?ids=${spots.map((s) => encodeURIComponent(s.dataset.totalFor!)).join(',')}`)
        .then((r) => (r.ok ? r.json() : Promise.reject()))
        .then((d: { counts: Record<string, Record<string, number>> }) => {
          for (const s of spots) {
            const total = Object.values(d.counts[s.dataset.totalFor!] ?? {}).reduce((a, b) => a + b, 0);
            if (total > 0) {
              s.innerHTML = `${total}<span class="visually-hidden"> ${total === 1 ? 'reaction' : 'reactions'}</span>`;
              s.hidden = false;
            }
          }
        })
        .catch(() => {});
    'requestIdleCallback' in window ? requestIdleCallback(run, { timeout: 2000 }) : setTimeout(run, 600);
  }
</script>
