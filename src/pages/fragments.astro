---
import Base from '../layouts/Base.astro';
import { getNotes } from '../lib/content';
import { site } from '../data/site';

const notes = getNotes();
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base title="Fragments" description="Short lines and notes by Manas H Arawalli, from his Substack Notes.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Fragments · {notes.length} notes</p>
      <h1>Fragments</h1>
      <p class="lede">
        Lines that didn't need a whole essay. Some are mine, some I'm borrowing. All of them first appeared in my{' '}
        <a href={site.substackNotes} rel="noopener" target="_blank">Substack Notes</a>, and new ones arrive here on their own.
      </p>
      <p class="also"><a href="/blog">← Back to the notebook</a></p>
    </header>

    <ul class="notes" role="list">
      {
        notes.map((n, i) => (
          <li class="reveal" style={`--delay:${(i % 3) * 80}ms`} id={`note-${n.id}`}>
            <figure>
              {n.body && (
                <blockquote>
                  {n.body.split(/\n\s*\n/).map((para) => (
                    <p>{para}</p>
                  ))}
                </blockquote>
              )}
              {n.image && <img src={n.image} alt="Image attached to this note" loading="lazy" decoding="async" />}
              {n.quote && (
                <div class="borrowed quote">
                  <blockquote cite={n.quote.url ?? undefined}>
                    <p>{n.quote.text}</p>
                  </blockquote>
                  <p class="source">
                    {n.quote.author && <span>{n.quote.author}</span>}
                    {n.quote.author && n.quote.title && <span aria-hidden="true"> · </span>}
                    {n.quote.title &&
                      (n.quote.url ? (
                        <a href={n.quote.url} rel="noopener" target="_blank">
                          {n.quote.title}
                        </a>
                      ) : (
                        <cite>{n.quote.title}</cite>
                      ))}
                  </p>
                </div>
              )}
              {n.restack && (
                <div class="borrowed restack">
                  {n.restack.author && <p class="who">{n.restack.author}</p>}
                  {n.restack.body && <p class="said">{n.restack.body}</p>}
                  {n.restack.image && <img src={n.restack.image} alt={`Image attached to ${n.restack.author ?? 'the'} note`} loading="lazy" decoding="async" />}
                  {n.restack.url && (
                    <a class="source" href={n.restack.url} rel="noopener" target="_blank">
                      Their note on Substack
                    </a>
                  )}
                </div>
              )}
              <figcaption>
                <time datetime={n.date}>{fmt.format(new Date(n.date))}</time>
                <a href={n.url} rel="noopener" target="_blank">
                  View on Substack<span class="visually-hidden"> (note from {fmt.format(new Date(n.date))})</span>
                </a>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .lede a {
    color: var(--accent);
  }
  .also {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--step--1);
  }
  .also a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-soft);
  }
  /* Arriving from search: show which note it was. */
  .notes li:target figure {
    border-color: var(--accent);
  }
  .notes {
    list-style: none;
    margin: 0;
    padding: 0 0 var(--space-7);
    columns: 3 18rem;
    column-gap: var(--space-4);
  }
  .notes li {
    break-inside: avoid;
    margin-bottom: var(--space-4);
  }
  figure {
    margin: 0;
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
  }
  blockquote {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.45;
    font-style: italic;
    white-space: pre-line;
  }
  blockquote p + p {
    margin-top: 0.6em;
  }
  figure img {
    margin-top: var(--space-3);
    border-radius: 8px;
    width: 100%;
  }
  /* Something borrowed: a line from someone's post, or a note he restacked. */
  .borrowed {
    padding: var(--space-3);
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  blockquote + .borrowed,
  img + .borrowed {
    margin-top: var(--space-3);
  }
  .borrowed blockquote {
    font-size: var(--step-0);
  }
  .borrowed .source,
  .borrowed .who {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .borrowed .who {
    margin-top: 0;
  }
  .borrowed a {
    color: var(--accent);
  }
  .borrowed .said {
    margin-top: var(--space-1);
    line-height: 1.45;
    white-space: pre-line;
  }
  a.source {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  figcaption {
    margin-top: var(--space-3);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  figcaption a {
    color: var(--accent);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
</style>
