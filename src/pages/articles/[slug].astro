---
import Reading from '../../layouts/Reading.astro';
import { getEssays, type Piece } from '../../lib/content';

export async function getStaticPaths() {
  return (await getEssays()).map((piece) => ({ params: { slug: piece.slug }, props: { piece } }));
}

const { piece } = Astro.props as { piece: Piece };
---

<Reading piece={piece}>
  <Fragment set:html={piece.html} />
</Reading>
