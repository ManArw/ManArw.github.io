---
import Reading from '../../layouts/Reading.astro';
import { getArticles, type Article } from '../../lib/substack';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((a) => ({ params: { slug: a.slug }, props: { article: a } }));
}

const { article } = Astro.props as { article: Article };
---

<Reading
  kind="Essay"
  title={article.title}
  subtitle={article.subtitle}
  date={article.date}
  minutes={article.minutes}
  backHref="/articles"
  sourceUrl={article.url}
>
  <Fragment set:html={article.html} />
</Reading>
