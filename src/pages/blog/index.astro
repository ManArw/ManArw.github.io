---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, getNotes } from '../../lib/content';
import { tone } from '../../lib/tone';

const posts = await getPosts();
const featured = posts.find((p) => p.entry?.data.featured && p.cover && typeof p.cover !== 'string');
const rest = posts.filter((p) => p !== featured);
const notes = getNotes();
const latestNote = notes.find((n) => n.body.length < 220);
const fmt = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric' });
// The featured post's cover glows in its own colours (src/lib/tone.ts).
const glow = featured?.cover && typeof featured.cover !== 'string' ? await tone(featured.cover) : '';
---

<Base title="Blog" description="Shorter posts, notes, and travel writing from Manas H Arawalli.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Blog</p>
      <h1>The notebook</h1>
      <p class="lede">Travel writing, notes from building a business, and whatever doesn't fit an essay.</p>
    </header>

    {
      featured && featured.cover && typeof featured.cover !== 'string' && (
        <a class="feature reveal" href={featured.href} style={glow}>
          <Image src={featured.cover} alt={featured.coverAlt ?? ''} widths={[640, 1024, 1400]} sizes="(min-width: 1100px) 68rem, 100vw" />
          <span class="feature-body">
            <span class="eyebrow">
              Travelogue · {fmt.format(featured.date)} · {featured.minutes} min read
            </span>
            <span class="feature-title">{featured.title}</span>
            <span class="feature-sub">{featured.excerpt}</span>
          </span>
        </a>
      )
    }

    <div class="list">
      {rest.length ? <PostList pieces={rest} /> : !featured && <p class="empty">Nothing here yet. The first post is on its way.</p>}
    </div>

    {
      latestNote && (
        <section class="fragments reveal" aria-labelledby="fragments-title">
          <p class="eyebrow">Shorter still</p>
          <h2 id="fragments-title">Fragments</h2>
          <blockquote>
            <p>{latestNote.body}</p>
          </blockquote>
          <a class="more" href="/fragments">
            All {notes.length} fragments from my Substack Notes <span aria-hidden="true">→</span>
          </a>
        </section>
      )
    }
  </div>
</Base>

<style>
  .feature {
    position: relative;
    display: block;
    margin-bottom: var(--space-6);
    border-radius: 16px;
    overflow: hidden;
    color: #eef3f8;
    text-decoration: none;
    isolation: isolate;
  }
  .feature :global(img) {
    width: 100%;
    aspect-ratio: 16 / 8;
    object-fit: cover;
    background-image: var(--ph, none);
    transition: transform 1.2s var(--ease-out);
  }
  /* The light of the cover photo spilling onto the page around it. */
  .feature {
    box-shadow:
      -2.4rem -1.6rem 6rem -1.2rem color-mix(in srgb, var(--g1, transparent) 45%, transparent),
      2.4rem -1.6rem 6rem -1.2rem color-mix(in srgb, var(--g2, transparent) 45%, transparent),
      -2.4rem 1.6rem 6rem -1.2rem color-mix(in srgb, var(--g3, transparent) 45%, transparent),
      2.4rem 1.6rem 6rem -1.2rem color-mix(in srgb, var(--g4, transparent) 45%, transparent);
  }
  /* As the card arrives, its photo settles into the frame. */
  @media (prefers-reduced-motion: no-preference) {
    .feature.is-in :global(img) {
      animation: feature-settle 2.4s var(--ease-out) backwards;
    }
  }
  @keyframes feature-settle {
    from {
      scale: 1.1;
    }
  }
  .feature:hover :global(img) {
    transform: scale(1.03);
  }
  .feature::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 18, 32, 0.9), rgba(10, 18, 32, 0.1) 60%);
  }
  .feature-body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    display: grid;
    gap: var(--space-2);
    padding: clamp(1.25rem, 4vw, 2.5rem);
    max-width: 44rem;
  }
  .feature .eyebrow {
    color: #c9d5e3;
  }
  .feature-title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.05;
  }
  .feature-sub {
    font-style: italic;
    color: #d6dfea;
  }
  .list {
    padding-bottom: var(--space-6);
  }
  .empty {
    color: var(--ink-soft);
    font-style: italic;
  }
  .fragments {
    max-width: 36rem;
    margin: 0 auto;
    padding-bottom: var(--space-7);
    text-align: center;
  }
  .fragments h2 {
    margin-top: var(--space-2);
    font-size: var(--step-2);
    font-weight: 300;
  }
  .fragments blockquote {
    margin: var(--space-4) 0 0;
    font-size: var(--step-1);
    font-style: italic;
    line-height: 1.45;
    white-space: pre-line;
  }
  .fragments blockquote p::before {
    content: '“';
  }
  .fragments blockquote p::after {
    content: '”';
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 44px;
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--step--1);
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .feature :global(img) {
      aspect-ratio: 4 / 5;
    }
  }
</style>
