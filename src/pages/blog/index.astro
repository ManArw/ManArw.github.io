---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';

const entries = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const featured = entries.find((e) => e.data.featured && e.data.cover);
const posts = entries
  .filter((e) => e !== featured)
  .map((e) => ({
    href: `/blog/${e.id}`,
    title: e.data.title,
    subtitle: e.data.summary,
    date: e.data.date,
  }));
const fmt = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric' });
---

<Base title="Blog" description="Shorter posts, notes, and travel writing from Manas H Arawalli.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Blog</p>
      <h1>The notebook</h1>
      <p class="lede">Travel writing, notes from building a business, and whatever doesn't fit an essay.</p>
    </header>

    {
      featured && featured.data.cover && (
        <a class="feature reveal" href={`/blog/${featured.id}`}>
          <Image src={featured.data.cover} alt={featured.data.coverAlt ?? ''} widths={[640, 1024, 1400]} sizes="(min-width: 1100px) 68rem, 100vw" />
          <span class="feature-body">
            <span class="eyebrow">Travelogue · {fmt.format(featured.data.date)}</span>
            <span class="feature-title">{featured.data.title}</span>
            <span class="feature-sub">{featured.data.summary}</span>
          </span>
        </a>
      )
    }

    <div class="list">
      {posts.length ? <PostList posts={posts} /> : !featured && <p class="empty">Nothing here yet. The first post is on its way.</p>}
    </div>
  </div>
</Base>

<style>
  .feature {
    position: relative;
    display: block;
    margin-bottom: var(--space-6);
    border-radius: 16px;
    overflow: hidden;
    color: #eef3f8;
    text-decoration: none;
    isolation: isolate;
  }
  .feature :global(img) {
    width: 100%;
    aspect-ratio: 16 / 8;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }
  .feature:hover :global(img) {
    transform: scale(1.03);
  }
  .feature::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 18, 32, 0.9), rgba(10, 18, 32, 0.1) 60%);
  }
  .feature-body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    display: grid;
    gap: var(--space-2);
    padding: clamp(1.25rem, 4vw, 2.5rem);
    max-width: 44rem;
  }
  .feature .eyebrow {
    color: #c9d5e3;
  }
  .feature-title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.05;
  }
  .feature-sub {
    font-style: italic;
    color: #d6dfea;
  }
  .list {
    padding-bottom: var(--space-7);
  }
  .empty {
    color: var(--ink-soft);
    font-style: italic;
  }
  @media (max-width: 640px) {
    .feature :global(img) {
      aspect-ratio: 4 / 5;
    }
  }
</style>
