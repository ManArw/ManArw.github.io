---
import { render } from 'astro:content';
import Reading from '../../layouts/Reading.astro';
import { getPosts, type Piece } from '../../lib/content';

export async function getStaticPaths() {
  return (await getPosts()).map((piece) => ({ params: { slug: piece.slug }, props: { piece } }));
}

const { piece } = Astro.props as { piece: Piece };
const { Content, headings } = await render(piece.entry!);
---

<Reading piece={piece} toc={headings.filter((h) => h.depth === 2)}>
  <Content />
</Reading>
