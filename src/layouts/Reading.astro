---
// Shared layout for a single piece (Substack essay or blog post). Everything
// it shows comes from the piece in the content model (src/lib/content.ts).
import { Image } from 'astro:assets';
import Base from './Base.astro';
import Listen from '../components/Listen.astro';
import Reactions from '../components/Reactions.astro';
import Share from '../components/Share.astro';
import { neighbours, related, kindLabel, type Piece } from '../lib/content';
import { site } from '../data/site';

interface Props {
  piece: Piece;
  toc?: { slug: string; text: string }[];
}
const { piece, toc = [] } = Astro.props;
const essay = piece.kind === 'essay';
const backHref = essay ? '/articles' : '/blog';
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const { older, newer } = await neighbours(piece);
const more = await related(piece, 3);
const localCover = piece.cover && typeof piece.cover !== 'string' ? piece.cover : undefined;
const ogImage = `${site.url}/og${piece.href}.jpg`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': essay ? 'Article' : 'BlogPosting',
  headline: piece.title,
  description: piece.excerpt,
  datePublished: piece.date.toISOString(),
  author: { '@type': 'Person', name: site.name, url: site.url },
  publisher: { '@type': 'Person', name: site.name, url: site.url },
  image: ogImage,
  url: piece.url,
  mainEntityOfPage: piece.url,
  wordCount: piece.words,
  inLanguage: 'en',
  ...(piece.tags.length ? { keywords: piece.tags.join(', ') } : {}),
  ...(piece.sourceUrl ? { isBasedOn: piece.sourceUrl } : {}),
  ...(piece.audio
    ? {
        audio: {
          '@type': 'AudioObject',
          name: `${piece.title} (narration)`,
          contentUrl: new URL(piece.audio.src, site.url).href,
          encodingFormat: 'audio/mpeg',
          duration: `PT${Math.floor(piece.audio.duration / 60)}M${Math.round(piece.audio.duration % 60)}S`,
          contentSize: `${Math.round(piece.audio.bytes / 1024)} KB`,
        },
      }
    : {}),
};
---

<Base
  title={piece.title}
  description={piece.excerpt}
  type="article"
  published={piece.date}
  tags={piece.tags}
  jsonLd={jsonLd}
  imageAlt={`${piece.title}, by ${site.name}`}
>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>
  <article class="measure" aria-labelledby="piece-title">
    <header class="head">
      <a class="back" href={backHref}>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>
        {essay ? 'All essays' : 'All posts'}
      </a>
      <p class="eyebrow">
        {kindLabel(piece.kind)} · <time datetime={piece.date.toISOString()}>{fmt.format(piece.date)}</time> · {piece.minutes} min read
      </p>
      <h1 id="piece-title">{piece.title}</h1>
      {piece.subtitle && <p class="sub">{piece.subtitle}</p>}
    </header>

    {piece.audio && <Listen audio={piece.audio} title={piece.title} />}

    {
      localCover && (
        <div class="cover">
          <Image src={localCover} alt={piece.coverAlt ?? ''} widths={[640, 1024, 1600, 2000]} sizes="(min-width: 1100px) 64rem, 100vw" loading="eager" fetchpriority="high" />
        </div>
      )
    }

    {
      toc.length > 2 && (
        <nav class="toc" aria-label="Contents">
          <details>
            <summary>Jump to a day</summary>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </details>
        </nav>
      )
    }

    <div class="prose">
      <slot />
    </div>

    <footer class="end">
      <p class="fin" aria-hidden="true">✦</p>
      <Reactions id={piece.id} />
      <Share url={piece.url} title={piece.title} />
      {
        piece.sourceUrl && (
          <p class="source">
            First published on Substack, where you can subscribe or leave a comment.{' '}
            <a href={piece.sourceUrl} rel="noopener" target="_blank">
              Read on Substack <span aria-hidden="true">→</span>
            </a>
          </p>
        )
      }
    </footer>
  </article>

  <aside class="after measure" aria-label="More writing">
    {
      (older || newer) && (
        <nav class="pager" aria-label={essay ? 'Previous and next essays' : 'Previous and next posts'}>
          {older ? (
            <a class="older" href={older.href} rel="prev">
              <span class="k">← Previous</span>
              <span class="t">{older.title}</span>
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a class="newer" href={newer.href} rel="next">
              <span class="k">Next →</span>
              <span class="t">{newer.title}</span>
            </a>
          )}
        </nav>
      )
    }

    {
      more.length > 0 && (
        <section class="related" aria-labelledby="related-title">
          <h2 id="related-title">You might also like</h2>
          <ul role="list">
            {more.map((p) => (
              <li>
                <a href={p.href}>
                  <span class="k">
                    {kindLabel(p.kind)} · {p.minutes} min
                  </span>
                  <span class="t">{p.title}</span>
                  <span class="x">{p.excerpt}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="leave">
      <a href={backHref}>{essay ? 'Back to all essays' : 'Back to the notebook'}</a>
      <span aria-hidden="true">·</span>
      <a href="/random" data-random>Or read something at random</a>
    </p>
  </aside>
</Base>

<style>
  .progress {
    position: fixed;
    top: 4rem;
    left: 0;
    right: 0;
    height: 2px;
    z-index: var(--z-nav);
    pointer-events: none;
  }
  .progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(var(--read, 0));
    transform-origin: left;
  }
  article {
    padding-top: calc(var(--space-7) + 1rem);
  }
  .head {
    margin-bottom: var(--space-5);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 44px;
    margin-bottom: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
    color: var(--ink-soft);
  }
  .back:hover {
    color: var(--ink);
  }
  .back svg {
    width: 1.1em;
    height: 1.1em;
    transition: transform var(--dur-1);
  }
  .back:hover svg {
    transform: translateX(-3px);
  }
  h1 {
    margin-top: var(--space-3);
    font-size: var(--step-3);
    font-weight: 400;
    overflow-wrap: break-word;
  }
  .sub {
    margin-top: var(--space-3);
    font-size: var(--step-1);
    font-style: italic;
    color: var(--ink-soft);
    line-height: 1.45;
  }
  .cover {
    width: min(100vw - 2rem, 64rem);
    margin: 0 0 var(--space-5) 50%;
    transform: translateX(-50%);
  }
  .cover :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 12px;
  }
  .toc {
    margin-bottom: var(--space-5);
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    font-family: var(--font-display);
  }
  .toc summary {
    cursor: pointer;
    padding: var(--space-3) var(--space-4);
    min-height: 44px;
    font-weight: 500;
    list-style-position: inside;
  }
  .toc ol {
    margin: 0;
    padding: 0 var(--space-4) var(--space-4) calc(var(--space-4) + 1.2em);
    display: grid;
    gap: var(--space-2);
  }
  .toc a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .prose :global(.steps) {
    display: inline-block;
    padding: 0.2em 0.9em;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  /* ---------- end of the piece ---------- */
  .end {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-5);
    text-align: center;
  }
  .fin {
    font-size: 1.2rem;
    color: var(--accent);
  }
  .source {
    max-width: 30rem;
    margin-inline: auto;
    font-size: var(--step--1);
    font-style: italic;
    color: var(--ink-soft);
  }
  .source a {
    color: var(--accent);
    font-style: normal;
    font-family: var(--font-display);
    font-weight: 500;
    white-space: nowrap;
  }

  .after {
    padding-block: var(--space-6) var(--space-7);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-block: 1px solid var(--line);
  }
  .pager a {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-2);
    text-decoration: none;
  }
  .pager .newer {
    text-align: right;
    grid-column: 2;
  }
  .k {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .t {
    font-family: var(--font-display);
    font-size: var(--step-0);
    line-height: 1.25;
    transition: color var(--dur-1);
  }
  .pager a:hover .t,
  .related a:hover .t {
    color: var(--accent);
  }
  .related {
    margin-top: var(--space-6);
  }
  .related h2 {
    font-size: var(--step-1);
    font-weight: 300;
    margin-bottom: var(--space-3);
  }
  .related ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .related li + li {
    border-top: 1px solid var(--line);
  }
  .related a {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-4);
    text-decoration: none;
  }
  .x {
    font-size: var(--step--1);
    font-style: italic;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .leave {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0 var(--space-3);
    font-family: var(--font-display);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .leave a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-soft);
  }
  .leave a:hover {
    color: var(--ink);
  }
  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager .newer {
      grid-column: 1;
      text-align: left;
    }
    .pager > span:empty {
      display: none;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const article = document.querySelector<HTMLElement>('article');
  if (bar && article) {
    // Progress through the article itself, not the related links below it.
    let ticking = false;
    const update = () => {
      const top = article.offsetTop;
      const span = article.offsetHeight - window.innerHeight;
      const read = span > 0 ? (window.scrollY - top + 64) / span : 1;
      bar.style.setProperty('--read', String(Math.min(1, Math.max(0, read))));
      ticking = false;
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    window.addEventListener('resize', update, { passive: true });
  }
</script>
